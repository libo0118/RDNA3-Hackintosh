+#include "drm_xnu.h"
+#define radv_bo_mmap(addr, len, prot, flags, fd, off) drm_xnu_mmap(addr, len, prot, flags, fd, off)
+#define radv_bo_munmap(addr, len)                    drm_xnu_munmap(addr, len)
+#define RADV_BO_MMAP_FIXED                           0
+#else
+#define radv_bo_mmap(addr, len, prot, flags, fd, off) mmap(addr, len, prot, flags, fd, off)
+#define radv_bo_munmap(addr, len)                    munmap(addr, len)
+#define RADV_BO_MMAP_FIXED                           1
+#endif
+
 static void radv_amdgpu_winsys_bo_destroy(struct radeon_winsys *_ws, struct radeon_winsys_bo *_bo);
 
 static int
@@ -378,7 +392,7 @@ radv_amdgpu_winsys_bo_destroy(struct radeon_winsys *_ws, struct radeon_winsys_bo
    }
 
