-      munmap(bo->cpu_map, bo->base.size);
+      radv_bo_munmap(bo->cpu_map, bo->base.size);
 
    if (ws->debug_all_bos)
       radv_amdgpu_global_bo_list_del(ws, bo);
@@ -737,8 +751,12 @@ radv_amdgpu_winsys_bo_map(struct radeon_winsys *_ws, struct radeon_winsys_bo *_b
