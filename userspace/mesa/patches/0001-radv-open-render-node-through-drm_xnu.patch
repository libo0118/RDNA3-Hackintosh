diff --git a/src/amd/vulkan/radv_physical_device.c b/src/amd/vulkan/radv_physical_device.c
index 5edb325..0cc4293 100644
--- a/src/amd/vulkan/radv_physical_device.c
+++ b/src/amd/vulkan/radv_physical_device.c
@@ -17,6 +17,20 @@
 #include <sys/sysmacros.h>
 #endif
 
+#if defined(__APPLE__) || defined(RADV_DRM_XNU)
+/* macOS: the "render node" is RDNA3Accel's IOUserClient (libdrm_xnu); it
+ * has no /dev/dri inode, so VK_EXT_physical_device_drm reports 0:0.
+ * RADV_DRM_XNU takes the same path on a Linux host (loopback backend). */
+#include "drm_xnu.h"
+#define radv_drm_open(path, flags) drm_xnu_open(path, flags)
+#define radv_drm_close(fd)         drm_xnu_close(fd)
+#define radv_drm_stat(path, st)    (memset((st), 0, sizeof(*(st))), 0)
+#else
+#define radv_drm_open(path, flags) open(path, flags)
+#define radv_drm_close(fd)         close(fd)
+#define radv_drm_stat(path, st)    stat(path, st)
+#endif
+
 #include "vk_drm_syncobj.h"
 #include "vk_log.h"
 #include "vk_shader_module.h"
@@ -2604,14 +2618,14 @@ radv_physical_device_try_create(struct radv_instance *instance, drmDevicePtr drm
    enum radv_drm_device_type drm_device_type;
    drmVersionPtr version;
 
-   fd = open(path, O_RDWR | O_CLOEXEC);
+   fd = radv_drm_open(path, O_RDWR | O_CLOEXEC);
    if (fd < 0) {
       return vk_errorf(instance, VK_ERROR_INCOMPATIBLE_DRIVER, "Could not open device %s: %m", path);
    }
 
    version = drmGetVersion(fd);
    if (!version) {
-      close(fd);
+      radv_drm_close(fd);
 
       return vk_errorf(instance, VK_ERROR_INCOMPATIBLE_DRIVER,
                        "Could not get the kernel driver version for device %s: %m", path);
@@ -2622,7 +2636,7 @@ radv_physical_device_try_create(struct radv_instance *instance, drmDevicePtr drm
 #ifdef HAVE_AMDGPU_VIRTIO
       if (debug_get_bool_option("AMD_FORCE_VPIPE", false)) {
          drm_device_type = RADV_DRM_DEVICE_AMDGPU_VPIPE;
-         close(fd);
+         radv_drm_close(fd);
          fd = -1;
       }
 #endif
@@ -2634,7 +2648,7 @@ radv_physical_device_try_create(struct radv_instance *instance, drmDevicePtr drm
 #endif
    {
       drmFreeVersion(version);
-      close(fd);
+      radv_drm_close(fd);
 
       return vk_errorf(instance, VK_ERROR_INCOMPATIBLE_DRIVER, "Device '%s' is not using the AMDGPU kernel driver: %m",
                        path);
@@ -2869,7 +2883,7 @@ radv_physical_device_try_create(struct radv_instance *instance, drmDevicePtr drm
    pdev->bus_info = *drm_device->businfo.pci;
 
    if ((drm_device->available_nodes & (1 << DRM_NODE_PRIMARY)) &&
-       stat(drm_device->nodes[DRM_NODE_PRIMARY], &primary_stat) != 0) {
+       radv_drm_stat(drm_device->nodes[DRM_NODE_PRIMARY], &primary_stat) != 0) {
       result = vk_errorf(instance, VK_ERROR_INITIALIZATION_FAILED, "failed to stat DRM primary node %s",
                          drm_device->nodes[DRM_NODE_PRIMARY]);
       goto fail;
@@ -2877,7 +2891,7 @@ radv_physical_device_try_create(struct radv_instance *instance, drmDevicePtr drm
    pdev->primary_devid = primary_stat.st_rdev;
 
    if ((drm_device->available_nodes & (1 << DRM_NODE_RENDER)) &&
-       stat(drm_device->nodes[DRM_NODE_RENDER], &render_stat) != 0) {
+       radv_drm_stat(drm_device->nodes[DRM_NODE_RENDER], &render_stat) != 0) {
       result = vk_errorf(instance, VK_ERROR_INITIALIZATION_FAILED, "failed to stat DRM render node %s",
                          drm_device->nodes[DRM_NODE_RENDER]);
       goto fail;
@@ -2939,7 +2953,7 @@ radv_physical_device_try_create(struct radv_instance *instance, drmDevicePtr drm
    *pdev_out = pdev;
 
    if (fd != -1)
-      close(fd);
+      radv_drm_close(fd);
    fd = -1;
 
    return VK_SUCCESS;
@@ -2948,7 +2962,7 @@ fail:
    radv_physical_device_destroy(&pdev->vk);
 fail_fd:
    if (fd != -1)
-      close(fd);
+      radv_drm_close(fd);
    return result;
 #endif
 }
