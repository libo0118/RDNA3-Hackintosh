diff --git a/src/MtkBtStartupPolicy.h b/src/MtkBtStartupPolicy.h
new file mode 100644
index 0000000..5dd81f1
--- /dev/null
+++ b/src/MtkBtStartupPolicy.h
@@ -0,0 +1,24 @@
+#ifndef MTK_BT_STARTUP_POLICY_H
+#define MTK_BT_STARTUP_POLICY_H
+
+#include <stdint.h>
+
+namespace MtkBtStartupPolicy {
+inline bool isMt7925(uint32_t chipId) { return (chipId & 0xFFFF) == 0x7925; }
+
+// btmtk_fw_get_filename: the embedded _1_1 image only covers a ROM revision of zero.
+inline bool supportsFirmware(bool versionRead, uint32_t fwVersion) {
+    return versionRead && (fwVersion & 0xFF) == 0;
+}
+
+inline bool validEndpoint(uint8_t address, bool input) {
+    return (address & 0x0F) != 0 && (address & 0x70) == 0 && ((address & 0x80) != 0) == input;
+}
+
+inline bool hasRequiredEndpoints(uint8_t interruptIn, uint8_t bulkIn, uint8_t bulkOut) {
+    return validEndpoint(interruptIn, true) && validEndpoint(bulkIn, true) &&
+           validEndpoint(bulkOut, false) && interruptIn != bulkIn;
+}
+} // namespace MtkBtStartupPolicy
+
+#endif
