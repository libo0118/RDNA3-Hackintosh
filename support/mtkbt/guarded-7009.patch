@@ -0,0 +1,20 @@
+"""Check only the new match was added, preserving all existing personalities and KPI dependencies."""
+import plistlib
+import sys
+from pathlib import Path
+
+assert len(sys.argv) == 3, "usage: check-plist.py original-Info.plist candidate-Info.plist"
+original = plistlib.loads(Path(sys.argv[1]).read_bytes())
+candidate = plistlib.loads(Path(sys.argv[2]).read_bytes())
+assert candidate["IOKitPersonalities"].pop("MT7925 Bluetooth, USB 2c7c:7009") == {
+    "CFBundleIdentifier": "org.watchthelight.MtkBt",
+    "IOClass": "MtkBt",
+    "IOProviderClass": "IOUSBHostInterface",
+    "bConfigurationValue": 1,
+    "bInterfaceNumber": 0,
+    "idVendor": 0x2C7C,
+    "idProduct": 0x7009,
+}
+assert candidate == original, "existing matches, metadata or dependencies changed"
+assert "as.vit9696.Lilu" not in candidate["OSBundleLibraries"]
+print("plist: exact 2c7c:7009/configuration 1/interface 0 added; existing IDs and dependencies unchanged")
diff --git a/tests/startup-policy.cpp b/tests/startup-policy.cpp
new file mode 100644
index 0000000..63367a2
--- /dev/null
+++ b/tests/startup-policy.cpp
@@ -0,0 +1,42 @@
+#include "../src/MtkBtStartupPolicy.h"
+#include <assert.h>
+#include <stdio.h>
+
+#ifdef NDEBUG
+#error These tests require assertions.
+#endif
+
+using namespace MtkBtStartupPolicy;
+
+// Simulated download boundary; the predicates here are the ones the kernel calls before any download.
+static unsigned downloadCalls(uint32_t chip, bool versionRead, uint32_t fw,
+                              uint8_t interruptIn = 0x81, uint8_t bulkIn = 0x82, uint8_t bulkOut = 0x02) {
+    unsigned calls = 0;
+    if (hasRequiredEndpoints(interruptIn, bulkIn, bulkOut) && isMt7925(chip) && supportsFirmware(versionRead, fw))
+        ++calls;
+    return calls;
+}
+
+int main() {
+    assert(downloadCalls(0x7925, true, 0) == 1);
+    assert(downloadCalls(0x8A007925, true, 0xABCD0100) == 1); // Linux selects by the low byte only.
+    assert(downloadCalls(0x7925, false, 0) == 0); // A failed read must not look like ROM revision zero.
+    assert(downloadCalls(0x7925, false, 0x12345678) == 0);
+    for (uint32_t revision = 1; revision <= 0xFF; ++revision)
+        assert(downloadCalls(0x7925, true, 0xABCD0000 | revision) == 0);
+    const uint32_t otherChips[] = {0, 0x7921, 0x7961, 0xFFFFFFFF};
+    for (uint32_t chip : otherChips)
+        assert(downloadCalls(chip, true, 0) == 0);
+
+    for (unsigned present = 0; present < 7; ++present)
+        assert(downloadCalls(0x7925, true, 0, (present & 1) ? 0x81 : 0,
+                             (present & 2) ? 0x82 : 0, (present & 4) ? 0x02 : 0) == 0);
+    assert(downloadCalls(0x7925, true, 0, 0x83, 0x84, 0x04) == 1); // No guessed endpoint numbers.
+    assert(!hasRequiredEndpoints(0x80, 0x82, 0x02)); // EP0 is control, never the event pipe.
+    assert(!hasRequiredEndpoints(0x01, 0x82, 0x02));
+    assert(!hasRequiredEndpoints(0x81, 0x02, 0x02));
+    assert(!hasRequiredEndpoints(0x81, 0x82, 0x82));
+    assert(!hasRequiredEndpoints(0x91, 0x82, 0x02));
+    assert(!hasRequiredEndpoints(0x81, 0x81, 0x02));
+    puts("startup-policy: supported ROM passes; failed/unknown ROM, other chips and missing/invalid endpoints reject");
+}
