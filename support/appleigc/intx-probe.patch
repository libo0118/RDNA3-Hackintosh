+// Diagnostic hypothesis only; a source must really be non-messaged before selecting it.
+static bool igcProbeLegacyTypeOK(IOReturn status, int interruptType)
+{
+    return status == kIOReturnSuccess && !(interruptType & kIOInterruptTypePCIMessaged);
+}
